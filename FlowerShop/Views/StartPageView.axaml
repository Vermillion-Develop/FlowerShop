<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlowerShop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FlowerShop.Views.StartPageView"
        x:DataType="vm:StartPageViewModel">

    <Design.DataContext>
        <vm:StartPageViewModel/>
    </Design.DataContext>
    <Grid ColumnDefinitions="20*, 60*, 20*" RowDefinitions="20*, 80*">
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Background="#726A6A">
            <TextBlock FontSize="24" FontWeight="Bold"  Foreground="#FF3554" VerticalAlignment="Center" Margin="10,0,0,0" Text="FlowerShop"/>
        </Grid>
        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" VerticalAlignment="Center">
            <TextBlock Text="Логин"/>
            <TextBox Text="{Binding Login, Mode=TwoWay}"/>
            <TextBlock Text="Пароль" Margin="0,10,0,0"/>
            <TextBox PasswordChar="*" Text="{Binding Password, Mode=TwoWay}"/>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding GetLogginedCommand}" Cursor="Hand" Background="#FF355F" Foreground="White" Content="Войти" Margin="0,10,5,0">
                    <Button.Styles>
                        <Style Selector=":pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#CC1F1F"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Style>
                    </Button.Styles>
            </Button>
                <Button Command="{Binding GoToRegisterCommand}" Cursor="Hand" Background="#FF355F" Foreground="White" Content="Регистрация" Margin="0,10,0,0">
                    <Button.Styles>
                        <Style Selector=":pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#CC1F1F"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Style>
                    </Button.Styles>
            </Button>
            </StackPanel>
            
            <TextBlock HorizontalAlignment="Center" Foreground="Red" Text="{Binding Error}"/>
        </StackPanel>
    </Grid>
   

</UserControl>
